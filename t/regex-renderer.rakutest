use lib $?FILE.IO.parent.add('lib').Str;
use RedTestSource;
use lib red-test-source();
use Test;
use Red::Regex;
use Red::Compiler::Regex;
use X::Red::Exceptions;

my constant HAS-RAKUAST = $*CU.^name eq 'RakuAST::CompUnit';
unless HAS-RAKUAST {
    plan :skip-all('Regex compilation needs the RakuAST frontend');
    exit;
}

subtest 'Native renderer capabilities' => {
    my $scoped = Red::Compiler::Regex.new.compile(q[/a :i b/].AST.statements[0].expression);
    throws-like { $scoped.render(:dialect<Pg>) }, X::Red::Compiler::Unsupported,
        'PostgreSQL rejects scoped modes';
    my $large = Red::Compiler::Regex.new.compile(q[/a ** 256/].AST.statements[0].expression);
    ok $large.render(:dialect<Pg>).chars,
        'PostgreSQL lowers repetition bounds exceeding 255';
};

subtest 'Explicit lowering resource and capture diagnostics' => {
    my $capture = ['capture', 0, ['literal', 'a']];
    my $unsafe = Red::Regex.new(:tree(('sequence',
        ['repeat', $capture, 256, 256, False], ['backreference', (0,).List]).List));
    throws-like { $unsafe.render(:dialect<Pg>) }, X::Red::Compiler::Unsupported,
        :fatal(*.so), 'Direct AST users cannot duplicate referenced physical captures';
    my $deep = Red::Regex.new(:tree(('repeat', ['literal', 'a'],
        255 ** 18, 255 ** 18, False).List));
    throws-like { $deep.render(:dialect<Pg>) }, X::Red::Compiler::Unsupported,
        :fatal(*.so), 'Excessive nesting is a compiler diagnostic';
    my $wide = Red::Regex.new(:tree(('repeat', ['literal', 'a' x 40000],
        256, 256, False).List));
    throws-like { $wide.render(:dialect<Pg>) }, X::Red::Compiler::Unsupported,
        :fatal(*.so), 'Excessive expanded pattern text is a compiler diagnostic';
};

sub pattern(Str $source) {
    Red::Compiler::Regex.new.translate($source.AST.statements[0].expression, :dialect<Pg>)
}

is pattern(q[/^ 'Ana' $/]), '\AAna\Z', 'String anchors';
is pattern(q[/:i a/]), '(?i)a', 'Leading ignorecase';
is pattern(q[rx:i/a/]), '(?i)a', 'Quoted regex adverb';
is pattern(q[/\d \w \s ./]), '[[:digit:]][[:alnum:]_][[:space:]].', 'Common classes';
is pattern(q[/[a|b]+/]), '(?:(?:(?:a|b)))+', 'Group, alternatives and repetition';
is pattern(q[/a ** 2..4/]), '(?:a){2,4}', 'Bounded repetition';
is pattern(q[/a ** 3/]), '(?:a){3,3}', 'Exact repetition';
is pattern(q[/<[a..c _]>/]), '(?:a|b|c|_)', 'Explicit ASCII class';
is pattern(q[/'a.b$'/]), 'a\.b\$', 'Regex metacharacters in literals are escaped';
for q[/a { die 'must not execute' }/], q[/<{ 'a' }>/], q[/a :i b/], q[/a+:/], q[rx:r/a+/] -> $source {
    throws-like { pattern($source) }, X::Red::Compiler::Unsupported,
        "Reject unsupported syntax: $source";
}


done-testing;
